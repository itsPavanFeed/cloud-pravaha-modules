{
  "id": "azure-key-vault",
  "title": "Azure Key Vault (AVM)",
  "description": "Azure Verified Module Key Vault: no public network access, firewall deny-by-default, Azure RBAC (no legacy access policies), purge protection and 90-day soft delete, telemetry off.",
  "source": "Azure/avm-res-keyvault-vault/azurerm",
  "versions": [
    "0.12.0"
  ],
  "providers": [
    "Azure/azapi",
    "Azure/modtm",
    "hashicorp/azurerm",
    "hashicorp/random",
    "hashicorp/time"
  ],
  "inputs": [
    {
      "name": "name",
      "type": "string",
      "description": "Vault name.",
      "required": true,
      "pattern": "^[a-zA-Z][a-zA-Z0-9-]{1,22}[a-zA-Z0-9]$"
    },
    {
      "name": "location",
      "type": "string",
      "description": "Azure region.",
      "required": true,
      "pattern": "^[a-z0-9]{3,30}$"
    },
    {
      "name": "resource_group_name",
      "type": "string",
      "description": "Resource group name.",
      "required": true,
      "pattern": "^[A-Za-z0-9._()-]{1,90}$"
    },
    {
      "name": "tenant_id",
      "type": "string",
      "description": "Entra tenant ID.",
      "required": true,
      "pattern": "^[0-9a-f]{8}-([0-9a-f]{4}-){3}[0-9a-f]{12}$"
    },
    {
      "name": "sku_name",
      "type": "string",
      "description": "SKU.",
      "allowed": [
        "standard",
        "premium"
      ],
      "default": "standard"
    },
    {
      "name": "virtual_network_subnet_ids",
      "type": "list(string)",
      "into": "network_acls",
      "description": "Subnets allowed through the firewall.",
      "item_pattern": "^/subscriptions/[0-9a-f-]{36}/resourceGroups/[^/]+/providers/Microsoft\\.Network/virtualNetworks/[^/]+/subnets/[^/]+$",
      "max_items": 20
    },
    {
      "name": "tags",
      "type": "map(string)",
      "description": "Tags."
    }
  ],
  "enforced": {
    "enable_telemetry": false,
    "public_network_access_enabled": false,
    "purge_protection_enabled": true,
    "soft_delete_retention_days": 90,
    "legacy_access_policies_enabled": false,
    "network_acls": {
      "bypass": "AzureServices",
      "default_action": "Deny",
      "ip_rules": []
    }
  },
  "outputs": [
    "resource_id",
    "name",
    "uri"
  ]
}
