{
  "id": "azure-storage-account",
  "title": "Azure storage account (AVM)",
  "description": "Azure Verified Module storage account. Public network access, shared keys and nested public blobs are off, TLS 1.2 and infrastructure encryption are on, and Microsoft telemetry is disabled.",
  "source": "Azure/avm-res-storage-storageaccount/azurerm",
  "versions": [
    "0.10.0"
  ],
  "providers": [
    "Azure/azapi",
    "Azure/modtm",
    "hashicorp/random"
  ],
  "dependencies": [
    {
      "source": "Azure/avm-utl-interfaces/azure",
      "versions": [
        "0.6.0"
      ]
    }
  ],
  "inputs": [
    {
      "name": "name",
      "type": "string",
      "required": true,
      "description": "Storage account name.",
      "pattern": "^[a-z0-9]{3,24}$"
    },
    {
      "name": "location",
      "type": "string",
      "required": true,
      "description": "Azure region.",
      "pattern": "^[a-z0-9]{3,30}$"
    },
    {
      "name": "parent_id",
      "type": "string",
      "required": true,
      "description": "Resource group ID.",
      "pattern": "^/subscriptions/[0-9a-f-]{36}/resourceGroups/[A-Za-z0-9._()-]{1,90}$"
    },
    {
      "name": "account_tier",
      "type": "string",
      "description": "Performance tier.",
      "allowed": [
        "Standard",
        "Premium"
      ],
      "default": "Standard"
    },
    {
      "name": "account_replication_type",
      "type": "string",
      "description": "Replication.",
      "allowed": [
        "LRS",
        "ZRS",
        "GRS",
        "GZRS",
        "RAGRS",
        "RAGZRS"
      ],
      "default": "ZRS"
    },
    {
      "name": "tags",
      "type": "map(string)",
      "description": "Tags for the account."
    }
  ],
  "enforced": {
    "enable_telemetry": false,
    "public_network_access_enabled": false,
    "shared_access_key_enabled": false,
    "https_traffic_only_enabled": true,
    "min_tls_version": "TLS1_2",
    "allow_nested_items_to_be_public": false,
    "infrastructure_encryption_enabled": true
  },
  "outputs": [
    "resource_id",
    "name"
  ]
}
