{
  "id": "gcp-gke",
  "title": "GCP GKE private cluster",
  "description": "Private-node GKE cluster with shielded nodes, network policy, Workload Identity, a release channel and deletion protection. The default node pool is removed.",
  "source": "terraform-google-modules/kubernetes-engine/google//modules/private-cluster",
  "versions": [
    "46.0.0"
  ],
  "providers": [
    "hashicorp/google",
    "hashicorp/kubernetes",
    "hashicorp/random"
  ],
  "inputs": [
    {
      "name": "project_id",
      "type": "string",
      "description": "GCP project ID.",
      "required": true,
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
    },
    {
      "name": "name",
      "type": "string",
      "description": "Cluster name.",
      "required": true,
      "pattern": "^[a-z]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    {
      "name": "region",
      "type": "string",
      "description": "Region.",
      "required": true,
      "pattern": "^[a-z]+-[a-z]+[0-9]$"
    },
    {
      "name": "network",
      "type": "string",
      "description": "VPC network name.",
      "required": true,
      "pattern": "^[a-z]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    {
      "name": "subnetwork",
      "type": "string",
      "description": "Subnetwork name.",
      "required": true,
      "pattern": "^[a-z]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    {
      "name": "ip_range_pods",
      "type": "string",
      "description": "Secondary range name for pods.",
      "required": true,
      "pattern": "^[a-z]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    {
      "name": "ip_range_services",
      "type": "string",
      "description": "Secondary range name for services.",
      "required": true,
      "pattern": "^[a-z]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    {
      "name": "master_ipv4_cidr_block",
      "type": "string",
      "description": "/28 range for the control plane.",
      "required": true,
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/28$"
    },
    {
      "name": "enable_private_endpoint",
      "type": "bool",
      "description": "Make the control plane reachable only privately.",
      "default": true
    },
    {
      "name": "master_authorized_networks",
      "type": "json",
      "description": "List of {cidr_block, display_name} allowed to reach the control plane."
    },
    {
      "name": "release_channel",
      "type": "string",
      "description": "Release channel.",
      "allowed": [
        "RAPID",
        "REGULAR",
        "STABLE"
      ],
      "default": "REGULAR"
    },
    {
      "name": "node_pools",
      "type": "json",
      "description": "Node pools (name, machine_type, min_count, max_count...)."
    },
    {
      "name": "cluster_resource_labels",
      "type": "map(string)",
      "description": "Labels."
    }
  ],
  "enforced": {
    "enable_private_nodes": true,
    "enable_shielded_nodes": true,
    "deletion_protection": true,
    "network_policy": true,
    "remove_default_node_pool": true,
    "identity_namespace": "enabled",
    "enable_binary_authorization": true,
    "http_load_balancing": true
  },
  "outputs": [
    "cluster_id",
    "name",
    "endpoint"
  ]
}
