{
  "id": "aws-kms",
  "title": "AWS KMS key",
  "description": "Customer-managed symmetric KMS key with annual rotation and a 30-day deletion window.",
  "source": "terraform-aws-modules/kms/aws",
  "versions": [
    "4.2.2"
  ],
  "providers": [
    "hashicorp/aws"
  ],
  "inputs": [
    {
      "name": "description",
      "type": "string",
      "description": "Key description.",
      "required": true,
      "pattern": "^[A-Za-z0-9 ._:/-]{1,200}$"
    },
    {
      "name": "aliases",
      "type": "list(string)",
      "description": "Aliases (without alias/).",
      "item_pattern": "^[a-zA-Z0-9/_-]{1,200}$",
      "max_items": 10
    },
    {
      "name": "tags",
      "type": "map(string)",
      "description": "Tags."
    }
  ],
  "enforced": {
    "enable_key_rotation": true,
    "deletion_window_in_days": 30,
    "key_usage": "ENCRYPT_DECRYPT",
    "is_enabled": true
  },
  "outputs": [
    "key_arn",
    "key_id"
  ]
}
